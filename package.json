{
  "name": "vite-plugin-dom-source",
  "version": "1.0.1",
  "description": "Vite plugins that map rendered React and Vue DOM elements back to their source locations.",
  "keywords": [
    "vite",
    "react",
    "vue",
    "dom",
    "source-location",
    "vite-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "playground/react",
    "playground/vue"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:playground": "npm run build && npm run build --workspace @vite-plugin-dom-source/playground-react && npm run build --workspace @vite-plugin-dom-source/playground-vue",
    "dev:react": "npm run build && npm run dev --workspace @vite-plugin-dom-source/playground-react",
    "dev:vue": "npm run build && npm run dev --workspace @vite-plugin-dom-source/playground-vue",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "prepublishOnly": "npm run check",
    "release": "np"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vue/compiler-dom": "^3.5.41",
    "magic-string": "^1.2.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.41",
    "np": "^12.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41"
  }
}
